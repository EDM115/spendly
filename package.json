    "edm115-lint": "~0.2.1",
    "eslint": "~10.8.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "~17.8.0",
    "ink": "~7.1.1",
    "ink-text-input": "~6.0.0",
    "jiti": "~2.7.0",
    "lightningcss": "~1.33.0",
    "oxlint": "~1.76.0",
    "oxlint-tsgolint": "~7.0.2001",
    "pino-pretty": "~13.1.3",

  "imports": {
    "#shared/*": "./shared/*",
    "#server/*": "./server/*"
  },
  "license": "MIT",
  "name": "spendly",
  "packageManager": "pnpm@11.18.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EDM115/spendly.git"
  },
  "scripts": {
    "better-auth:generate": "pnpm db:ensure && pnpm dlx auth@latest generate --config server/utils/auth.ts --output shared/db/auth.schema.ts -y",
    "build": "dotenvx run -- nuxt build",
    "cleanup": "nuxt cleanup",
    "db:ensure": "node -e \"import('fs').then(fs => {try{fs.mkdirSync('db')}catch{}})\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:ensure && drizzle-kit migrate",
    "db:seed": "dotenvx run --env SEED=true --overload -- jiti init/seed_db.ts",
    "dev": "nuxt dev --no-clear",
    "dev:expose:global": "nuxt dev --no-clear --tunnel",
    "dev:expose:local": "nuxt dev --no-clear --public",
    "format": "eslint -c eslint.stylistic.config.ts --concurrency=auto --fix .",
    "lint": "pnpm run --stream \"/^lint:eslint|^lint:oxlint/\"",
    "lint:eslint": "eslint --cache --cache-location .eslintcache --concurrency=auto .",
    "lint:fix": "pnpm run --stream \"/^lint:fix:.*/\"",
    "lint:fix:eslint": "eslint --concurrency=auto --fix .",
    "lint:fix:oxlint": "oxlint --fix",
    "lint:oxlint": "oxlint",
    "log:analyze": "jiti scripts/analyze-logs.ts",
    "log:tui": "dotenvx run --env JITI_JSX=true --overload -- jiti scripts/log-tui.tsx",
    "preview": "dotenvx run -- nuxt preview --port 8880",
    "start": "dotenvx run --env PORT=8880 --overload -- node .output/server/index.mjs",
    "typecheck": "nuxt typecheck"
  },
  "type": "module",
  "version": "1.6.0"
}

    "@nuxt/fonts": "~0.13.0",
    "@nuxt/image": "~2.0.0",
    "@nuxtjs/i18n": "~10.2.3",
    "@pinia/nuxt": "~0.11.3",
    "@vueuse/core": "~14.2.1",
    "@vueuse/nuxt": "~14.2.1",
    "better-auth": "~1.4.18",
    "better-sqlite3": "~12.6.2",
    "canvas-to-svg": "~1.0.3",
    "chart.js": "~4.5.1",
    "drizzle-orm": "~0.45.1",
    "jspdf": "~4.1.0",
    "jszip": "~3.10.1",
    "nuxt": "~4.3.1",
    "nuxt-svgo": "~4.2.6",
    "pinia": "~3.0.4",
    "pino": "~10.3.1",
    "resend": "~6.9.2",
    "vue": "~3.5.28",
    "vue-chartjs": "~5.3.3",
    "vue-cloudflare-turnstile": "~1.0.3",
    "vuetify-nuxt-module": "~0.19.5",
    "zod": "~4.3.6"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "~1.52.0",
    "@nuxt/eslint": "~1.15.1",
    "@stylistic/eslint-plugin": "~5.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "latest",
    "@types/react": "~19.2.13",
    "@typescript-eslint/parser": "~8.55.0",
    "country-flag-emoji-polyfill": "~0.1.8",
    "drizzle-kit": "~0.31.9",
    "edm115-lint": "~0.1.6",
    "eslint": "~10.0.0",
    "eslint-plugin-drizzle": "~0.2.3",
    "eslint-plugin-vue": "~10.7.0",
    "globals": "~17.3.0",
    "ink": "~6.7.0",
    "ink-text-input": "~6.0.0",
    "jiti": "~2.6.1",
    "lightningcss": "~1.31.1",
    "oxlint": "~1.46.0",
    "oxlint-tsgolint": "~0.11.5",
    "pino-pretty": "~13.1.3",
    "react": "~19.2.4",
    "sass-embedded": "~1.97.3",
    "sass-loader": "~16.0.7",
    "tsx": "~4.21.0",
    "typescript": "~5.9.3",
    "vue-eslint-parser": "~10.2.0",
    "vue-tsc": "~3.2.4"
  },
  "peerDependencies": {
    "@better-fetch/fetch": "*"
  },
  "imports": {
    "#shared/*": "./shared/*",
    "#server/*": "./server/*"
  },
  "license": "MIT",
  "name": "spendly",
  "packageManager": "pnpm@10.29.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EDM115/spendly.git"
  },
  "scripts": {
    "better-auth:generate": "pnpm db:ensure && pnpm dlx @better-auth/cli@latest generate --config server/utils/auth.ts --output shared/db/auth.schema.ts -y",
    "better-auth:fix-schema": "tsx shared/db/fix-auth-relations.codemod.ts shared/db/auth.schema.ts --write",
    "build": "dotenvx run -- nuxt build",
    "cleanup": "nuxt cleanup",
    "db:ensure": "node -e \"import('fs').then(fs => {try{fs.mkdirSync('db')}catch{}})\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:ensure && drizzle-kit migrate",
    "db:seed": "dotenvx run --env SEED=true --overload -- tsx init/seed_db.ts",
    "dev": "nuxt dev --no-clear",
    "dev:expose:global": "nuxt dev --no-clear --tunnel",
    "dev:expose:local": "nuxt dev --no-clear --public",
    "format": "eslint -c eslint.stylistic.config.ts --concurrency=auto --fix .",
    "lint": "pnpm run --stream \"/^lint:eslint|^lint:oxlint/\"",
    "lint:eslint": "eslint --cache --cache-location .eslintcache --concurrency=auto .",
    "lint:fix": "pnpm run --stream \"/^lint:fix:.*/\"",
    "lint:fix:eslint": "eslint --concurrency=auto --fix .",
    "lint:fix:oxlint": "oxlint --fix --type-aware .",
    "lint:oxlint": "oxlint --type-aware .",
    "log:analyze": "tsx scripts/analyze-logs.ts",
    "log:tui": "tsx scripts/log-tui.tsx",
    "preview": "dotenvx run -- nuxt preview --port 88",
    "start": "dotenvx run -- node .output/server/index.mjs",
    "typecheck": "nuxt typecheck"
  },
  "type": "module",
  "version": "0.18.0"
}
